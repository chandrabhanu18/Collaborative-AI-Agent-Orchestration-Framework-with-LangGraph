# LLM Provider Configuration
LLM_API_KEY="sk-your-provider-key"
LLM_PROVIDER="openai"
LLM_MODEL="gpt-4o-mini"

# PostgreSQL Database
DATABASE_URL="postgresql://user:password@localhost:5432/agent_db"
ASYNC_DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/agent_db"

# Redis Cache & Message Broker
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# Application Configuration
API_PORT="8000"
API_HOST="0.0.0.0"
LOG_LEVEL="INFO"
LOG_FILE_PATH="logs/agent_activity.log"

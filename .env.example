# .env.example

# LLM Provider Configuration
# Required for LangGraph agents to communicate with an LLM.
LLM_API_KEY="sk-your-provider-key"
LLM_PROVIDER="openai"
LLM_MODEL="gpt-4o-mini"

# PostgreSQL Database
# URL used by the API and Worker to persist task state.
# Format: postgresql+asyncpg://user:password@host:port/dbname (for async API)
# Format: postgresql://user:password@host:port/dbname (for sync Celery worker)
DATABASE_URL="postgresql://user:password@db:5432/agent_db"
ASYNC_DATABASE_URL="postgresql+asyncpg://user:password@db:5432/agent_db"

# Redis Cache & Message Broker
# Used for Celery messaging and agent scratchpad state.
REDIS_URL="redis://redis:6379/0"
CELERY_BROKER_URL="redis://redis:6379/1"
CELERY_RESULT_BACKEND="redis://redis:6379/2"

# Application Configuration
API_PORT="8000"
API_HOST="0.0.0.0"
LOG_LEVEL="INFO"
LOG_FILE_PATH="logs/agent_activity.log"
